{
  "name": "resume",
  "version": "1.0.0",
  "private": true,
  "description": "JSON Resume — compact two-column HTML/PDF",
  "main": "index.js",
  "scripts": {
    "validate": "resumed validate resume.json && resumed validate resume.fr.json",
    "html": "node scripts/render-html.mjs en",
    "html:en": "node scripts/render-html.mjs en",
    "html:fr": "node scripts/render-html.mjs fr",
    "pdf": "node scripts/export-pdf.mjs en",
    "pdf:en": "node scripts/export-pdf.mjs en",
    "pdf:fr": "node scripts/export-pdf.mjs fr",
    "build": "npm run build:en && npm run build:fr",
    "build:en": "npm run html:en && npm run pdf:en",
    "build:fr": "npm run html:fr && npm run pdf:fr"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "puppeteer": "^24.40.0",
    "resumed": "^6.1.0"
  }
}
